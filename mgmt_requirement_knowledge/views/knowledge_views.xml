<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_knowledge_article_form_inherit_backlinks" model="ir.ui.view">
        <field name="name">knowledge.article.form.backlinks</field>
        <field name="model">knowledge.article</field>
        <field name="inherit_id" ref="knowledge.knowledge_article_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_knowledge_editor mt-3']" position="after">
                <style>
                .o_backlinks {
                    width: 100%;
                    max-width: calc(750px + 2 * var(--editor-gutter-size));
                    margin-left: auto;
                    margin-right: auto;
                    padding-left: var(--editor-gutter-size) !important;
                    padding-right: calc(var(--editor-gutter-size) + 40px) !important;
                }

            </style>
                <div class="o_backlinks mt-4" invisible="not paragraph_ids">
                    <h3>Backlinks</h3>
                    <field name="paragraph_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="name" />
                            <button
                                name="action_open_paragraph"
                                type="object"
                                string="Open"
                                icon="fa-external-link"
                                class="btn-link"
                            />
                        </list>
                    </field>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
