<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="risk_form_view" model="ir.ui.view">
        <field name="name">mgmt_risk.risk_form_view</field>
        <field name="model">mgmt.risk</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <field
                        name="stage"
                        widget="statusbar"
                        options="{'clickable': '1'}"
                        statusbar_visible="identify,evaluate,mitigate"
                    />
                    <field name="head_risk_id" invisible="1" />
                    <button
                        name="action_create_revision"
                        string="Create Revision"
                        type="object"
                        invisible="head_risk_id == True"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Revision"
                        bg_color="bg-danger"
                        invisible="head_risk_id == False"
                    />
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                        <field name="description" />
                    </div>
                    <notebook>
                        <page string="General Information" name="general_info">
                            <group>
                                <group>
                                    <field name="system_id" />
                                    <field name="risk_owner_id" />
                                    <field name="hazard_ids" widget="many2many_tags" />
                                    <field name="risk_acceptance" />
                                    <field name="severity_id" />
                                    <field name="probability_id" />
                                    <field name="risk_combination_id" />
                                    <field name="write_date" />
                                </group>
                            </group>
                        </page>
                        <page
                            string="Revisions"
                            name="revisions"
                            invisible="head_risk_id == True"
                        >
                            <field name="revision_risk_ids" nolabel="1">
                                <list order="revision_count">
                                    <field name="display_name" />
                                    <field name="risk_owner_id" />
                                    <field name="hazard_ids" widget="many2many_tags" />
                                    <field name="severity_id" />
                                    <field name="probability_id" />
                                    <field name="risk_combination_id" />
                                    <field name="stage" />
                                    <field name="write_date" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="risk_view_tree" model="ir.ui.view">
        <field name="name">mgmt_risk.risk_tree_view</field>
        <field name="model">mgmt.risk</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="name" />
                <field name="risk_owner_id" />
                <field name="severity_id" />
                <field name="probability_id" />
                <field name="risk_combination_id" />
                <field name="stage" />
            </list>
        </field>
    </record>

    <record id="risk_search_view" model="ir.ui.view">
        <field name="name">mgmt_risk.risk_search_view</field>
        <field name="model">mgmt.risk</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="system_id" />
                <group expand="0">
                    <filter
                        name="group_by_system"
                        context="{'group_by': 'system_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="risk_kanban_view" model="ir.ui.view">
      <field name="name">mgmt_risk.risk_kanban_view</field>
      <field name="model">mgmt.risk</field>
      <field name="arch" type="xml">
        <kanban
                class="o_kanban_small_column"
                default_group_by="stage"
                quick_create="False"
            >
          <field name="name" />
          <field name="risk_owner_id" />
          <field name="severity_id" />
          <field name="probability_id" />
          <field name="severity_color" />
          <field name="probability_color" />
          <field name="risk_combination_color" />

          <templates>
            <t t-name="kanban-box">
              <div t-attf-class="oe_kanban_global_click">
                <div t-attf-class="o_kanban_title">
                  <strong><field name="name" /></strong>
                </div>
                <div class="o_kanban_details">
                  <div>Owner: <field name="risk_owner_id" /></div>
                  <div class="mt-1 mb-1">
                    Severity:
                    <span
                                        t-attf-class="p-1  color-index-#{record.severity_color.value}"
                                    >
                      <field name="severity_id" />
                    </span>
                  </div>
                  <div class="mt-1 mb-1">
                    Probability:
                    <span
                                        t-attf-class="p-1  color-index-#{record.probability_color.value}"
                                    >
                      <field name="probability_id" />
                    </span>
                  </div>
                  <div class="mt-1 mb-1">
                    Score:
                    <span
                                        t-attf-class="p-1 color-index-#{record.risk_combination_color.value}"
                                    >
                      <field name="risk_combination_id" />
                    </span>
                  </div>
                </div>
              </div>
            </t>
          </templates>

        </kanban>
      </field>
    </record>


    <record id="action_mgmt_risk_view" model="ir.actions.act_window">
        <field name="name">Risks</field>
        <field name="res_model">mgmt.risk</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('head_risk_id', '=', False)]</field>
        <field name="search_view_id" ref="risk_search_view" />
    </record>

    <menuitem
        id="menu_evaluation_risks"
        name="Risks"
        parent="mgmt_base.menu_mgmt_evaluation"
        action="action_mgmt_risk_view"
        sequence="10"
    />

</odoo>
