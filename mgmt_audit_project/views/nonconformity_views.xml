<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="nonconformity_form_view" model="ir.ui.view">
      <field name="name">mgmt_audit_project.nonconformity_form_view</field>
      <field name="model">mgmt.nonconformity</field>
      <field name="inherit_id" ref="mgmt_audit.nonconformity_form_view" />
      <field name="arch" type="xml">
        <page name="general_info" position="after">
          <page string="Tasks" name="tasks">
            <field name="project_id" invisible="1" />
            <field
                        name="task_ids"
                        context="{'default_nonconformity_id': id, 'default_project_id': project_id}"
                    >
              <list>
                <field name="name" />
                <field name="company_id" optional="hide" />
                <field name="project_id" />
                <field name="date_deadline" />
              </list>
            </field>
          </page>
        </page>
    </field>
    </record>

</odoo>
