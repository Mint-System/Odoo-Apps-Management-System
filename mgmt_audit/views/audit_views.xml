<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="audit_form_view" model="ir.ui.view">
        <field name="name">mgmt_audit.audit_form_view</field>
        <field name="model">mgmt.audit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable': 1}"
                        statusbar_visible="draft,ready,in_progress,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <field name="description" />
                    <notebook>
                        <page string="General Information" name="general_info">
                            <group>
                                <group>
                                    <field name="type" />
                                    <field name="planned_date" />
                                    <field name="responsible_id" />
                                    <field name="auditor_ids" widget="many2many_tags" />
                                </group>
                            </group>
                        </page>
                        <page string="Statements" name="statements">
                            <field
                                name="statement_ids"
                                domain="[('audit_id','=',False)]"
                                context="{'default_audit_id': id}"
                                nolabel="1"
                            >
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="risk_id" />
                                    <field name="nonconformity_id" />
                                    <button
                                        type="object"
                                        name="get_formview_action"
                                        string="Open"
                                        icon="fa-edit"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="audit_view_tree" model="ir.ui.view">
        <field name="name">mgmt_audit.audit_tree_view</field>
        <field name="model">mgmt.audit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="type" />
                <field name="planned_date" />
                <field name="stage_id" />
                <field name="responsible_id" />
            </list>
        </field>
    </record>

    <record id="audit_kanban_view" model="ir.ui.view">
        <field name="name">mgmt_audit.audit_kanban_view</field>
        <field name="model">mgmt.audit</field>
        <field name="arch" type="xml">
            <kanban
                class="o_kanban_small_column"
                default_group_by="stage_id"
                quick_create="false"
            >
                <!-- fields used in the card -->
                <field name="name" />
                <field name="type" />
                <field name="planned_date" />
                <field name="stage_id" />
                <field name="responsible_id" />

                <templates>
                    <!-- Odoo 19 card template -->
                    <t t-name="card">
                        <div class="row mb4">
                            <div class="col-2 text-nowrap">
                                <field class="fw-bold" name="name" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div>
                                    <span class="fw-bold">Type: </span>
                                    <field name="type" />
                                </div>
                                <div>
                                    <span class="fw-bold">Planned: </span>
                                    <field name="planned_date" />
                                </div>
                                <div>
                                    <span class="fw-bold">Responsible: </span>
                                    <field name="responsible_id" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="audit_search_view" model="ir.ui.view">
        <field name="name">mgmt_audit.audit_search_view</field>
        <field name="model">mgmt.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="action_mgmt_audit_view" model="ir.actions.act_window">
        <field name="name">Audits</field>
        <field name="res_model">mgmt.audit</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="mgmt_audit.audit_search_view" />
    </record>

    <menuitem
        id="menu_audit_audits"
        name="Audits"
        parent="mgmt_base.menu_mgmt_audit"
        action="action_mgmt_audit_view"
        sequence="10"
    />
</odoo>
